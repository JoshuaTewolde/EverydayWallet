# Tap environment. Copy to `.env` (gitignored). NEVER commit real values.

# ---------- Server (apps/server) ----------
PORT=8788
# Google Gemini API key (server-only; GitHub secret GEMINI_API_KEY). Empty = receipt scan off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# CORS origins. The Android WebView origin is https://localhost.
CORS_ORIGINS=https://localhost,http://localhost,http://localhost:5174
RECEIPTS_PER_MINUTE=10

# ---------- Mobile app (baked into the APK at build time; NOT secret) ----------
# Public URL of apps/server (e.g. https://tap.yourdomain.com). Used for receipt scan + USD price.
VITE_API_URL=
# Solana RPC (devnet). Default: https://api.devnet.solana.com
VITE_SOLANA_RPC=
