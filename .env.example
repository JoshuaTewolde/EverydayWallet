# Tap environment. Copy to `.env` (gitignored). NEVER commit real values.

# ---------- Server (apps/server) ----------
PORT=8788
# Google Gemini API key (server-only; GitHub secret GEMINI_API_KEY). Empty = receipt scan off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# CORS origins. The Android WebView origin is https://tap.local.
CORS_ORIGINS=https://tap.local,http://localhost:5174
RECEIPTS_PER_MINUTE=10

# ---------- Mobile app (baked into the APK at build time; NOT secret) ----------
# Public URL of apps/server (e.g. https://tap.yourdomain.com). Used for receipt scan + USD price.
VITE_API_URL=
# Solana RPC (devnet). Default: https://api.devnet.solana.com
VITE_SOLANA_RPC=
# Breez SDK API key for the in-app bitcoin wallet (regtest). Ships INSIDE the APK: it identifies
# the app to Breez, it is not a wallet key. Empty = bitcoin hidden. GitHub secret VITE_BREEZ_API_KEY.
VITE_BREEZ_API_KEY=
